# Project URL: dạng https://<project-ref>.supabase.co (KHÔNG phải link dashboard, không có /rest/v1)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# anon (legacy) hoặc publishable key (sb_publishable_...). KHÔNG dùng service_role / sb_secret_
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
